# Vorlage: Kopieren nach ".env" und die Passwörter durch eigene, zufällige Werte ersetzen
# (z. B. mit:  openssl rand -hex 16)
COMPOSE_PROJECT_NAME=cloudnova

# Datenbank (PostgreSQL 16)
POSTGRES_DB=cloudnova
POSTGRES_USER=cloudnova_admin
POSTGRES_PASSWORD=CHANGE_ME_admin_password
# Eingeschränkter Anwendungs-Benutzer (nur SELECT) – verwendet vom Backend
APP_DB_USER=cloudnova_app
APP_DB_PASSWORD=CHANGE_ME_app_password

# Frontend-Veröffentlichung auf dem Host
#   127.0.0.1 = nur lokal (Standard, Entwicklung)
#   100.x.y.z = Tailscale-IP dieses PCs (Zugriff nur über das Overlay-Netzwerk)
#   0.0.0.0   = alle Schnittstellen (nicht empfohlen)
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080
