# CloudNova: Nginx (Tier 1), statische Auslieferung und Reverse Proxy zur API.
# Dies ist ein Template: Das Image ersetzt ${BACKEND_UPSTREAM} beim Start per envsubst
# und schreibt das Ergebnis nach /etc/nginx/conf.d/default.conf.
#   Variante A (alles auf einem Host): BACKEND_UPSTREAM=http://backend:3000 (Standard)
#   Variante B (drei PCs):             BACKEND_UPSTREAM=http://<Tailscale-IP-Backend-PC>:3000
# Läuft mit nginx-unprivileged als Benutzer "nginx" auf Port 8080 (kein Root).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src 'self'" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Reverse Proxy zur API. Der Docker-DNS (127.0.0.11) wird zur Laufzeit befragt, damit
    # "docker compose up --scale backend=3" funktioniert (Round-Robin über alle Backend-Instanzen)
    # und Nginx auch startet, wenn das Backend kurz nicht erreichbar ist.
    location /api/ {
        resolver 127.0.0.11 valid=5s ipv6=off;
        set $backend_upstream ${BACKEND_UPSTREAM};
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }

    # Eigener Health-Endpunkt von Nginx (für den Docker-Healthcheck)
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        try_files $uri $uri/ /index.html;
        expires 5m;
    }
}
