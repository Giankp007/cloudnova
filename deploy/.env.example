# Vorlage für Variante B (drei PCs). Kopieren nach deploy/.env und ausfüllen.
# Jeder PC braucht nur die Werte, die seine Compose-Datei verwendet:
#   Datenbank-PC: POSTGRES_*, APP_DB_*, DB_BIND
#   Backend-PC:   POSTGRES_DB, APP_DB_*, DB_HOST, BACKEND_BIND
#   Frontend-PC:  BACKEND_HOST, FRONTEND_BIND, FRONTEND_PORT
# Die Passwörter müssen auf dem Datenbank-PC und dem Backend-PC (APP_DB_PASSWORD) übereinstimmen.
# Passwörter nie ins Git und nie in den Chat: Weitergabe nur direkt (z. B. Passwortmanager).

POSTGRES_DB=cloudnova
POSTGRES_USER=cloudnova_admin
POSTGRES_PASSWORD=CHANGE_ME_admin_password
APP_DB_USER=cloudnova_app
APP_DB_PASSWORD=CHANGE_ME_app_password

# Tailscale-IPs (anzeigen mit:  tailscale ip -4)
DB_BIND=100.x.x.x          # Tailscale-IP des Datenbank-PCs
DB_HOST=100.x.x.x          # gleiche IP: das Backend verbindet sich dorthin
BACKEND_BIND=100.y.y.y     # Tailscale-IP des Backend-PCs
BACKEND_HOST=100.y.y.y     # gleiche IP: Nginx leitet dorthin weiter
FRONTEND_BIND=100.z.z.z    # Tailscale-IP des Frontend-PCs
FRONTEND_PORT=8080
